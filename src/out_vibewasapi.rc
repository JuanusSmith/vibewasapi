#include <windows.h>
#include "resource.h"
#include "version.h"

IDD_CONFIG DIALOGEX 0, 0, 260, 284
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Vibe Wasapi Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Output device:", -1, 7, 9, 80, 8
    COMBOBOX        IDC_DEVICE, 7, 20, 246, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Exclusive mode (bit-perfect when volume is 100% and pan is centred)", IDC_EXCLUSIVE, 7, 40, 246, 10
    AUTOCHECKBOX    "Fall back to shared mode if exclusive mode fails", IDC_FALLBACK, 17, 53, 236, 10
    AUTOCHECKBOX    "Apply Winamp volume / pan in software", IDC_VOLUME, 7, 66, 246, 10
    LTEXT           "Buffer length (ms):", -1, 7, 84, 110, 8
    EDITTEXT        IDC_RINGMS, 120, 82, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "Device period (ms, 0 = default):", -1, 7, 100, 110, 8
    EDITTEXT        IDC_PERIODMS, 120, 98, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    GROUPBOX        "Now playing", -1, 7, 118, 246, 62
    LTEXT           "", IDC_STATUS, 13, 129, 234, 48
    GROUPBOX        "Exclusive-mode formats this device accepts (stereo)", -1, 7, 186, 246, 72
    EDITTEXT        IDC_FORMATS, 13, 198, 234, 54, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Changes apply from the next track.", -1, 7, 266, 138, 8
    DEFPUSHBUTTON   "OK", IDOK, 149, 263, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 263, 50, 14
END

// The version numbers come from version.h, so they only need changing there.
1 VERSIONINFO
FILEVERSION     VIBE_VERSION_MAJOR,VIBE_VERSION_MINOR,0,0
PRODUCTVERSION  VIBE_VERSION_MAJOR,VIBE_VERSION_MINOR,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Juanus Smith"
            VALUE "FileDescription",  "Output Plug-in"
            VALUE "FileVersion",      VIBE_VERSION_FILE_TEXT
            VALUE "InternalName",     "out_vibewasapi"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Juanus Smith"
            VALUE "OriginalFilename", "out_vibewasapi.dll"
            VALUE "ProductName",      "Vibe Wasapi"
            VALUE "ProductVersion",   VIBE_VERSION_FILE_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
